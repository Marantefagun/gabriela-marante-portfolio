---
/* En Figma es un logo suelto sobre el footer. Aquí es un enlace real
   al principio de la página, que es lo que su forma sugiere. */
---

<a class="to-top" href="#top" aria-label="Volver arriba">
  <svg viewBox="0 0 56 56" fill="none" aria-hidden="true" focusable="false">
    <path
      d="M27.8289 22.2588C28.2043 21.9182 28.7838 21.9104 29.1687 22.2568C29.5536 22.6033 29.6069 23.1808 29.3074 23.5898L29.2429 23.6689L20.2429 33.6689C19.8735 34.0794 19.2413 34.1126 18.8308 33.7432C18.4204 33.3737 18.3872 32.7415 18.7566 32.3311L27.7566 22.3311L27.8289 22.2588Z"
      fill="currentColor"></path>
    <path
      d="M29.281 22.375C28.936 21.9437 28.306 21.8737 27.8748 22.2187C27.4435 22.5638 27.3735 23.1937 27.7185 23.625L35.7185 33.625C36.0635 34.0563 36.6935 34.1263 37.1248 33.7812C37.556 33.4362 37.626 32.8063 37.281 32.375L29.281 22.375Z"
      fill="currentColor"></path>
  </svg>
</a>

<style>
  .to-top {
    position: absolute;
    transition: background-color var(--transition-state);
    right: 0;
    bottom: calc(100% + var(--space-to-top));
    width: var(--size-logo-button);
    height: var(--size-logo-button);
    border-radius: var(--radius);
    background-color: var(--color-surface-subtle);
    color: var(--color-brand);
  }

  .to-top:hover,
  .to-top:focus-visible {
    background-color: var(--color-surface-subtle-strong);
  }

  .to-top svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
