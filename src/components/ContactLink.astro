---
/* Fila de icono + enlace externo de la página de contacto.
   El icono llega por slot para que cada marca conserve sus colores. */
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<div class="row">
  <span class="row__icon" aria-hidden="true"><slot /></span>
  <a class="row__link" href={href} target="_blank" rel="noopener noreferrer">{label}</a>
</div>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .row__icon {
    flex: none;
    width: 32px;
    height: 32px;
  }

  /* El contenido del slot lleva el ámbito de la página que lo inserta,
     no el de este componente: de ahí el :global(). */
  .row__icon :global(svg),
  .row__icon :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .row__link {
    color: var(--color-ink);
    font-size: var(--text-md);
    text-decoration: underline;
    transition: color var(--transition-state);
  }

  .row__link:hover,
  .row__link:focus-visible {
    color: var(--color-brand);
  }
</style>
