---
import { Image } from 'astro:assets';

/* Tarjeta del selector de integraciones de Graphext. Reproduce su
   producto dentro del caso de estudio: las medidas salen del diseño y
   no son tokens del portfolio. */
interface Props {
  name: string;
  description: string;
  logo: ImageMetadata;
}

const { name, description, logo } = Astro.props;
---

<div class="integration">
  <Image class="integration__logo" src={logo} alt="" width={58} height={58} loading="eager" />
  <div class="integration__text">
    <p class="integration__name">{name}</p>
    <p class="integration__description">{description}</p>
  </div>
</div>

<style>
  .integration {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: space-between;
    width: 233px;
    height: 197px;
    padding: 21px;
    border: 1.295px solid #f2f2f2;
    border-radius: var(--radius-lg);
    background-color: #ffffff;
  }

  .integration__logo {
    width: 58px;
    height: 58px;
    margin-block: 10px;
    object-fit: contain;
  }

  .integration__text {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .integration__name {
    margin: 0;
    color: #000000;
    font-size: 15.54px;
  }

  .integration__description {
    margin: 0;
    color: #808080;
    font-size: 10.36px;
    font-weight: var(--weight-light);
  }
</style>
