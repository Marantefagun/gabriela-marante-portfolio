<style>
  /* El ritmo de esta página es más apretado que el de la home:
     60px entre bandas en todos los tamaños, no 100. */
  .shell {
    --space-band: 3.75rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    /* 42px: fuera de la escala de 8, pero se repite igual en los tres
       frames, así que es intencionado. */
    gap: 2.625rem;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .block__title {
    margin: 0;
    color: var(--color-brand);
    font-family: var(--font-display);
    font-size: var(--text-section);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-default);
    text-transform: uppercase;
  }

  .email {
    margin: 0;
  }

  .email a {
    color: var(--color-ink);
    font-size: var(--text-md);
    text-decoration: none;
    transition: color var(--transition-state);
  }

  .email a:hover,
  .email a:focus-visible {
    color: var(--color-brand);
    text-decoration: underline;
  }

  /* Los bloques de enlaces respiran más a partir de tablet. El del
     email no: mantiene sus 8px en los tres frames. */
  @media (min-width: 768px) {
    .block {
      gap: var(--space-2);
    }

    .block--email {
      gap: var(--space-1);
    }
  }
</style>
